{%- set t = ui[lang] -%}
{%- set secs = sections[lang] -%}
{%- set otherLang = t.switchLangCode -%}
{%- set isHome = (page.url == "/" + lang + "/") -%}
{%- if translationKey -%}
  {%- set alt = collections.articles | translationUrl(translationKey, otherLang) -%}
{%- else -%}
  {%- set alt = altUrl -%}
{%- endif -%}
{%- set supportUrl = (secs | last).url -%}
{%- if section and not published -%}{%- set secInfo = section | findSection(lang) -%}{%- endif -%}
{%- set pageTitle = (t.siteName + " – " + t.kicker) if isHome else (title + " · " + t.siteName) -%}
{%- set pageDesc = description or (secInfo.intro | truncate(158)) or t.siteDesc -%}
{%- set ogImage = site.url + "/assets/img/" + (section or "hero") + ".webp" -%}
{%- set selfUrl = site.url + page.url -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f6efe6">
  {%- if noindex %}
  <meta name="robots" content="noindex, follow">
  {%- else %}
  <link rel="canonical" href="{{ selfUrl }}">
  {%- if alt %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ selfUrl }}">
  <link rel="alternate" hreflang="{{ otherLang }}" href="{{ site.url + alt }}">
  <link rel="alternate" hreflang="x-default" href="{{ (selfUrl if lang == 'bg' else site.url + alt) }}">
  {%- endif %}
  {%- endif %}
  <meta property="og:site_name" content="{{ t.siteName }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="{{ 'article' if published else 'website' }}">
  <meta property="og:url" content="{{ selfUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:locale" content="{{ 'bg_BG' if lang == 'bg' else 'en_GB' }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/nunito-{{ 'cyrillic' if lang == 'bg' else 'latin' }}-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css">
  <script>document.documentElement.classList.add("js")</script>
  <script type="application/ld+json">{{ "" | jsonLd | safe }}</script>
</head>
<body>
  <a class="skip" href="#main">{{ t.skip }}</a>

  <div class="alert-bar" role="region" aria-label="{{ t.emergencyTitle }}">
    <div class="wrap">
      <span>{{ t.emergencyBar }}</span>
      <a href="tel:112"><strong>{{ t.emergencyCall }}</strong></a>
      <a href="{{ supportUrl }}#spesho">{{ t.emergencyMore }}</a>
    </div>
  </div>

  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="/{{ lang }}/">
        <svg class="brand-mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--sage)"/><path d="M9 19c2-6 7-9 14-9-1 7-5 12-12 12 0-2 .3-3 1-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{{ t.siteName }}</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">{{ t.menu }}</button>
      <nav id="nav" aria-label="{{ t.nav }}">
        <ul class="nav">
          {%- for s in secs %}
          <li><a href="{{ s.url }}"{% if page.url.startsWith(s.url) or section == s.key %} aria-current="page"{% endif %}>{{ s.short }}</a></li>
          {%- endfor %}
          <li><a href="/{{ lang }}/{{ 'tarsene' if lang == 'bg' else 'search' }}/">{{ t.search }}</a></li>
          <li><a class="lang" href="{{ alt or ('/' + otherLang + '/') }}" hreflang="{{ otherLang }}" lang="{{ otherLang }}">{{ t.switchLang }}</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p class="footer-brand">{{ t.siteName }}</p>
      <p>{{ t.footerNote }}</p>
      <p><a href="/{{ lang }}/{{ 'za-saita' if lang == 'bg' else 'about' }}/">{{ t.aboutLink }}</a> · <a href="{{ supportUrl }}#spesho">{{ t.emergencyTitle }}</a></p>
    </div>
  </footer>
  <script src="/assets/site.js" defer></script>
</body>
</html>
